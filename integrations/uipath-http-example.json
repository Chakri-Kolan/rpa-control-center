{
  "description": "Map these values to UiPath HTTP Request activities.",
  "base_url": "http://127.0.0.1:8080",
  "headers": {
    "Content-Type": "application/json",
    "X-API-Token": "read-from-secure-credential-store"
  },
  "lease": {
    "method": "POST",
    "path": "/api/v1/queues/sap-orders/lease",
