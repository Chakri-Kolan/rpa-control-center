  "components": {
    "schemas": {
      "CompleteRequest": {
        "properties": {
          "robot_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Robot Id"
          },
          "result": {
            "additionalProperties": true,
            "type": "object",
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "robot_id"
        ],
        "title": "CompleteRequest"
      },
      "EnqueueRequest": {
        "properties": {
          "queue_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Queue Name"
          },
          "reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reference"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "priority": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": -100.0,
            "title": "Priority",
            "default": 0
          },
          "max_attempts": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "default": 3
          },
          "actor": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Actor",
            "default": "api"
          }
        },
        "type": "object",
        "required": [
          "queue_name",
          "reference",
          "payload"
        ],
        "title": "EnqueueRequest"
      },
      "FailRequest": {
        "properties": {
          "robot_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Robot Id"
          },
          "error": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Error"
          },
          "retry_delay_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Retry Delay Seconds",
            "default": 60
          }
        },
        "type": "object",
        "required": [
          "robot_id",
          "error"
        ],
        "title": "FailRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeaseRequest": {
        "properties": {
          "robot_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Robot Id"
          },
          "lease_seconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 10.0,
            "title": "Lease Seconds",
            "default": 300
          }
        },
        "type": "object",
        "required": [
          "robot_id"
        ],
        "title": "LeaseRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
